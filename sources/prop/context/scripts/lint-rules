#!/usr/bin/env bash
# Prints the design-lint rule ids enabled in lint/rules.enabled, one per line.
# Single source of truth for `scripts/lint-cases` and the scripts/hooks/* gates,
# so adopting a rule there switches on every consumer at once.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
while IFS= read -r line || [ -n "$line" ]; do
  line="${line%%#*}"                                 # strip trailing comments
  line="$(printf '%s' "$line" | tr -d '[:space:]')"  # strip whitespace
  [ -n "$line" ] && printf '%s\n' "$line"
done < "$root/lint/rules.enabled"
