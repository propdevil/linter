#!/usr/bin/env bash
# design-lint runner. Builds the standalone linter once (release), then execs
# the binary directly so per-call latency is just parse+lint (no cargo/nix
# overhead). Used by the Stop hook and runnable by hand:
#   scripts/design-lint --rule async-blocking-operation services packages supervisor
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
manifest="$root/packages/design-lint/Cargo.toml"
export CARGO_TARGET_DIR="$root/packages/design-lint/target"
bin="$CARGO_TARGET_DIR/release/design-lint"
# Rebuild only when missing or when the linter source changed (keeps the
# per-call latency near zero once built).
if [ ! -x "$bin" ] || [ -n "$(find "$root/packages/design-lint/src" "$manifest" -newer "$bin" -print -quit 2>/dev/null)" ]; then
  nix develop "$root" --command cargo build -q --release --manifest-path "$manifest" 1>&2
fi
exec "$bin" "$@"
